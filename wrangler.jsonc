{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "server/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "extra-db",
      "database_id": "b10c9082-e3e2-47cd-adde-15209b05a1ad",
      "migrations_dir": "./server/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatWebSocket"
      },
      {
        "name": "APP_PRESENCE",
        "class_name": "PresenceWebSocket"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatWebSocket"]
    },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "ChatRoomDO", "to": "ChatWebSocket" }]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AppPresenceWebSocket"]
    },
    {
      "tag": "v4",
      "renamed_classes": [{ "from": "AppPresenceWebSocket", "to": "PresenceWebSocket" }]
    }
  ],
  "vars": {
    "CORS_ORIGIN": "tauri://localhost,https://tauri.localhost,http://localhost:1420",
    "EVALUATOR_URL": "https://extra-corporation-extraai.hf.space",
    "GENERATOR_URL": "https://extra-corporation-extra-ai-generator.hf.space",
    "RESEND_FROM": "extra IELTS <onboarding@resend.dev>"
  }
}
