{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "extra IELTS",
  "version": "0.1.0",
  "identifier": "com.psyc0dev.ielts",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "extra IELTS",
        "width": 1200,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": false,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
